# ================= ZAROORI (bina inke bot nahi chalega) =================
API_ID=
API_HASH=
BOT_TOKEN=
# Assistant account(s). Ek ho to SESSION_STRING, kai ho to SESSION_STRINGS (comma ya nayi line se alag)
SESSION_STRING=
SESSION_STRINGS=

# ================= /start SCREEN =================
START_PHOTO=
SUPPORT_URL=https://t.me/ZenithSsupport
# Update channel ka link (Update button). Khali rakho to button nahi dikhega
UPDATE_URL=

# ================= OWNER / STORAGE =================
# Apna Telegram user id (dead assistant wagairah ka private alert). Bot ko ek baar /start karna zaroori
OWNER_ID=
# Gaane yahan save hote hain (private channel, bot admin ho). Id aisi: -1001234567890
STORAGE_CHANNEL=

# ================= ADMIN PANEL =================
# ADMIN_PASSWORD khali = panel band
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=8080
TIMEZONE=Asia/Kolkata
# Railway Volume /data par mount karo to data redeploy ke baad bhi bachta hai
DB_PATH=/data/bot.db

# ================= YOUTUBE BLOCK SE BACHAV =================
# Proxy: ek ya kai (comma se alag)
PROXY=
# Cookies: COOKIES_B64, COOKIES_B64_1 ... COOKIES_B64_20 (ya COOKIES_TXT, COOKIES_TXT_1 ...)
COOKIES_B64=
COOKIES_B64_1=
COOKIES_B64_2=
COOKIES_TXT=
COOKIE_COOLDOWN=21600

# ================= DOWNLOAD / PLAYER (defaults theek hain) =================
DL_DIR=/tmp/tgm_audio
MAX_CACHE_MB=1500
MAX_DURATION=3600
MAX_FILESIZE_MB=150
DL_CONCURRENCY=12
SEARCH_CONCURRENCY=12
ALLOWED_DOMAINS=youtube.com,youtu.be,soundcloud.com
MAX_QUEUE=30
PLAY_COOLDOWN=3
# 1 = pause/skip/stop/loop sirf admins
CONTROLS_ADMIN_ONLY=1
STALL_GRACE=20
# Radio me jo feelings chhupani hain (comma se alag). Khali = sab dikhti hain (18+ bhi). Chhupane ho to: HIDDEN_MOODS=18+
HIDDEN_MOODS=

# ================= ASSISTANT / GROUP =================
# Itne din gaana na baje to assistant group chhod deta hai. 0 = kabhi nahi
IDLE_LEAVE_DAYS=30
# Assistant add na ho paye to itne second wait karke gaana shuru
RESUME_WAIT=300

# ================= NOTICES =================
VC_NOTICE_DEFAULT=1
WELCOME_DEFAULT=1
# Khali = default text. {name} aur {group} use kar sakte ho
WELCOME_TEXT=

# ================= STORAGE UPLOAD SPEED =================
UPLOAD_GAP=3
MAX_UPLOAD_BACKLOG=40

# ================= rebuild_cache.py =================
STOP_AFTER_EMPTY=400

# ================= 1000 GROUP SCALE =================
# Ek assistant account me ~500 group ki Telegram limit hai. 1000 group = kam se kam 3 assistant (SESSION_STRINGS)
ASSISTANT_MAX_GROUPS=450
# Ek saath gaana bajne wale groups ki had (server CPU par depend karta hai, apne server ke hisaab se kam/jyada karo)
MAX_ACTIVE_GROUPS=200
# Assistant ka wait karne wale groups ki had
MAX_WAITERS=150
# HIGH / MEDIUM / LOW (kam quality = kam CPU)
AUDIO_QUALITY=MEDIUM
# Telegram file download/upload ek saath kitne, aur chhoti FloodWait par auto-wait (sec)
TG_TRANSMISSIONS=8
TG_SLEEP_THRESHOLD=30
# Ek user ek gaane ko dobara itne minute baad like kar sakta hai
LIKE_COOLDOWN_MIN=20

# Rangeen buttons (blue/green/red). 0 = band karo. Library purani ho to apne aap normal buttons rahenge
BUTTON_COLORS=1

# Voice chat: "X joined the voice chat" / "X invited Y" messages (1 = on, 0 = off) aur kitne second baad delete ho
VC_JOIN_DEFAULT=1
VC_JOIN_DELETE_SEC=10
VC_INVITE_DELETE_SEC=30

# ================= COST TRACKER (admin panel: kharcha) =================
# Railway ke rates (USD). Pricing badle to yahan badlo
COST_RAM_GB_MONTH=10
COST_CPU_VCPU_MONTH=20
COST_EGRESS_GB=0.05
# Ek chalte gaane ka andaza (kilobit/sec). Railway Usage se mismatch ho to COST_SCALE badlo (1 = jaisa hai)
AUDIO_KBPS=64
COST_SCALE=1
